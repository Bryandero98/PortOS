language js

// Replaces the three @eslint-react rules that Biome 2.5 has no native equivalent
// for. The other five map onto built-in Biome rules (see biome.jsonc):
//   no-missing-key                            -> correctness/useJsxKeyInIterable
//   jsx-no-children-prop                      -> correctness/noChildrenProp
//   dom-no-render-return-value                -> correctness/noRenderReturnValue
//   dom-no-unsafe-target-blank                -> security/noBlankTarget
//   dom-no-dangerously-set-innerhtml-with-children
//                                             -> security/noDangerouslySetInnerHtmlWithChildren
or {
  // --- @eslint-react/dom-no-find-dom-node ----------------------------------
  // Matches both the imported `findDOMNode(x)` and the `ReactDOM.findDOMNode(x)`
  // namespaced form.
  or {
    `findDOMNode($args)`,
    `$obj.findDOMNode($args)`
  } as $findNode where {
    register_diagnostic(
      span = $findNode,
      message = "findDOMNode is deprecated and was removed in React 19. Use a ref instead.",
      severity = "error"
    )
  },

  // --- @eslint-react/no-direct-mutation-state ------------------------------
  // Flags `this.state.foo = x` (any assignment operator, incl. `??=`), but not
  // `this.state = {...}` in a constructor, where the object is `this` rather
  // than something containing `this.state`.
  JsStaticMemberAssignment(object = $stateObject) as $mutation where {
    $stateObject <: contains `this.state`,
    register_diagnostic(
      span = $mutation,
      message = "Do not mutate state directly. Use 'setState()' instead.",
      severity = "error"
    )
  },

  // --- @eslint-react/no-missing-component-display-name ---------------------
  // Flags an anonymous function or arrow passed to memo()/forwardRef().
  // NOTE: one deliberate divergence from @eslint-react — that rule also accepts a
  // later `Component.displayName = '...'` assignment as satisfying the
  // requirement; this pattern does not, so it is slightly STRICTER (never weaker).
  // `client/src` has zero memo()/forwardRef() call sites today, so the stricter
  // reading costs nothing; name the function and the diagnostic goes away.
  or {
    `memo($fn)`,
    `forwardRef($fn)`,
    `$react.memo($fn)`,
    `$react.forwardRef($fn)`
  } as $wrapped where {
    or {
      $fn <: JsArrowFunctionExpression(),
      and {
        $fn <: JsFunctionExpression(id = $fnId),
        $fnId <: .
      }
    },
    register_diagnostic(
      span = $wrapped,
      message = "Add missing 'displayName' for component: name the function passed to memo()/forwardRef().",
      severity = "error"
    )
  }
}
