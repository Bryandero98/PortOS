# Block install scripts by default to reduce supply-chain attack surface.
#
# This file is NOT redundant with the repo-root .npmrc: npm resolves the project
# config from the *local prefix* and never walks up the directory tree. So the
# root .npmrc does not apply to `cd client && npm install`, nor to
# `npm ci --prefix client` (which is what CI runs) — the local prefix is
# `client/` in both cases. Without this file the guard silently does not hold
# here, which is how a preinstall-hook worm (e.g. the Aug 2026 keyv/cacheable
# compromise) would have gotten a free execution slot.
#
# No client dependency currently needs an install script, so there is nothing to
# rebuild for this workspace (vite 8 dropped the esbuild binary dependency).
ignore-scripts=true
