# Block install scripts by default to reduce supply-chain attack surface.
#
# IMPORTANT: this file only covers installs whose *local prefix* is the repo
# root. npm reads the project config from the local prefix and never walks up
# the directory tree, so `cd client && npm install` and `npm ci --prefix server`
# do NOT see this file — each workspace carries its own .npmrc for that reason
# (client/.npmrc, server/.npmrc, autofixer/.npmrc, browser/.npmrc). Deleting any
# silently reopens an install-time code-execution slot for every dependency in
# that workspace.
#
# Packages with legitimate install scripts are rebuilt explicitly from the
# allowlist in scripts/trusted-rebuilds.js (shared by `npm run setup`,
# scripts/ensure-deps.js, update.sh/update.ps1 and CI). Currently only the
# server needs any: node-pty (native PTY addon), sharp (insurance — ships
# prebuilt bindings today), and onnxruntime-node / protobufjs (best-effort).
ignore-scripts=true
