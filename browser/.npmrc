# Block install scripts by default to reduce supply-chain attack surface.
# See client/.npmrc for why this cannot be inherited from the repo-root .npmrc:
# npm reads the project config from the local prefix and never walks upward.
#
# This workspace has no dependencies today, so the setting is purely pre-emptive —
# it means the guard is already in place if any are ever added, rather than the
# addition silently arriving with an install-time execution slot.
ignore-scripts=true
