# Block install scripts by default to reduce supply-chain attack surface.
#
# This file is NOT redundant with the repo-root .npmrc: npm resolves the project
# config from the *local prefix* and never walks up the directory tree. So the
# root .npmrc does not apply to `cd server && npm install`, nor to
# `npm ci --prefix server` (which is what CI runs) — the local prefix is
# `server/` in both cases. Without this file the guard silently does not hold
# here, which is how a preinstall-hook worm (e.g. the Aug 2026 keyv/cacheable
# compromise) would have gotten a free execution slot.
#
# The server DOES have dependencies with legitimate native builds (node-pty and
# friends). They are rebuilt explicitly from the allowlist in
# scripts/trusted-rebuilds.js — run `node scripts/trusted-rebuilds.js server`
# after any install here, or just use `npm run setup` / `npm start`, which do it
# for you. Skipping that step leaves node-pty unbuilt and the shell/TUI features
# will crash on a missing binding.
ignore-scripts=true
